{
  "id": "bug-fix",
  "title": "Bug fix",
  "description": "Locate the root cause, gate on the fix plan, implement, review the diff, validate and deploy the changed files.",
  "inputs": [
    {
      "key": "description",
      "label": "Bug description",
      "kind": "text",
      "attachTo": true
    },
    {
      "key": "runTests",
      "label": "Run local Apex tests during validation",
      "kind": "boolean",
      "default": false
    },
    {
      "key": "deploy",
      "label": "Deploy to the default org at the end",
      "kind": "boolean",
      "default": true
    },
    {
      "key": "visualTest",
      "label": "Visual test before deploy (opens the org in the browser with your LOCAL UI files + live org data)",
      "kind": "boolean",
      "default": false
    }
  ],
  "steps": [
    {
      "use": "snapshot",
      "title": "Snapshot baseline"
    },
    "locate",
    {
      "use": "bug-fix.approve-plan",
      "as": "approve-plan"
    },
    {
      "use": "retrieve-fresh",
      "title": "Retrieve fresh copies of affected files from the org"
    },
    {
      "use": "retrieve-delta",
      "title": "Compare retrieved files against the investigated versions"
    },
    "rebaseline",
    {
      "use": "bug-fix.implement",
      "as": "implement"
    },
    {
      "use": "changes",
      "title": "Collect changed files"
    },
    "verify-standards",
    {
      "use": "bug-fix.review",
      "as": "review"
    },
    {
      "use": "bug-fix.approve-changes",
      "as": "approve-changes"
    },
    {
      "use": "bug-fix.validate",
      "as": "validate"
    },
    "validate-tests",
    "visual-preview",
    {
      "use": "bug-fix.approve-deploy",
      "as": "approve-deploy"
    },
    {
      "use": "deploy",
      "title": "Deploy changed files"
    }
  ]
}
