{
  "id": "test-gen",
  "title": "Test generation",
  "description": "Add meaningful Apex tests to existing code: assess coverage gaps for the target classes, gate on the test plan, write the tests, validate with local tests, deploy to the sandbox.",
  "inputs": [
    {
      "key": "target",
      "label": "Target classes (comma-separated names, or describe the area)",
      "kind": "text"
    },
    {
      "key": "deploy",
      "label": "Deploy the new tests to the connected sandbox",
      "kind": "boolean",
      "default": true
    }
  ],
  "steps": [
    {
      "use": "snapshot",
      "title": "Snapshot baseline"
    },
    "assess",
    {
      "use": "test-gen.approve-plan",
      "as": "approve-plan"
    },
    {
      "use": "test-gen.implement",
      "as": "implement"
    },
    {
      "use": "changes",
      "title": "Collect changed files"
    },
    "verify-standards",
    {
      "use": "test-gen.approve-changes",
      "as": "approve-changes"
    },
    {
      "use": "test-gen.validate",
      "as": "validate"
    },
    {
      "use": "test-gen.approve-deploy",
      "as": "approve-deploy"
    },
    {
      "use": "deploy",
      "title": "Deploy the tests"
    }
  ]
}
