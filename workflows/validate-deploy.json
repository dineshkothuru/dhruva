{
  "id": "validate-deploy",
  "title": "Validate deploy",
  "description": "Gate, then check-only deploy of a source path with the chosen test level. Works on any org (no source tracking required) - nothing is ever saved to the org.",
  "inputs": [
    {
      "key": "target",
      "label": "Source path to validate",
      "kind": "text",
      "default": "force-app"
    },
    {
      "key": "testLevel",
      "label": "Test level",
      "kind": "select",
      "options": [
        "NoTestRun",
        "RunLocalTests",
        "RunAllTestsInOrg"
      ],
      "default": "RunLocalTests"
    }
  ],
  "steps": [
    "approve",
    {
      "use": "validate-deploy.validate",
      "as": "validate"
    }
  ]
}
