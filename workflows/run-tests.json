{
  "id": "run-tests",
  "title": "Run Apex tests",
  "description": "Run Apex tests in the default org with code coverage.",
  "inputs": [
    {
      "key": "level",
      "label": "Test level",
      "kind": "select",
      "options": [
        "RunLocalTests",
        "RunAllTestsInOrg",
        "RunSpecifiedTests"
      ],
      "default": "RunLocalTests"
    },
    {
      "key": "tests",
      "label": "Class names (only for RunSpecifiedTests, comma-separated)",
      "kind": "text",
      "default": ""
    },
    {
      "key": "synchronous",
      "label": "Run synchronously (avoids UNABLE_TO_LOCK_ROW when tests contend on shared records; slower)",
      "kind": "boolean",
      "default": false
    }
  ],
  "steps": [
    "run"
  ]
}
