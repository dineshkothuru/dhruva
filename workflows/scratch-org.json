{
  "id": "scratch-org",
  "title": "Scratch org from this folder",
  "description": "Create a scratch org (needs an authorized Dev Hub), push this folder's source into it, and open it in the browser.",
  "inputs": [
    {
      "key": "alias",
      "label": "Scratch org alias",
      "kind": "text",
      "default": "scratch1"
    },
    {
      "key": "days",
      "label": "Duration (days)",
      "kind": "select",
      "options": [
        "1",
        "7",
        "14",
        "30"
      ],
      "default": "7"
    }
  ],
  "steps": [
    "confirm",
    "create",
    "push",
    "open"
  ]
}
