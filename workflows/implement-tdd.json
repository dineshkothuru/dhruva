{
  "id": "implement-tdd",
  "title": "Implement from TDD",
  "description": "Build what an approved Technical Design Document specifies: plan gate, fresh org copies, implementation with tests, standards check, review, validate, deploy to the connected sandbox.",
  "inputs": [
    {
      "key": "tddPath",
      "label": "TDD path (from a Solution design run - see .dhruva/runs/<runId>/docs/)",
      "kind": "text",
      "default": ""
    },
    {
      "key": "tasksPath",
      "label": "Build-plan tasks file from the same run (blank = single-pass build)",
      "kind": "text",
      "default": ""
    },
    {
      "key": "scope",
      "label": "Scope note (optional - e.g. only components 1-3)",
      "kind": "text",
      "default": "",
      "attachTo": true
    },
    {
      "key": "runTests",
      "label": "Run local Apex tests during validation",
      "kind": "boolean",
      "default": true
    },
    {
      "key": "deploy",
      "label": "Deploy to the connected sandbox at the end",
      "kind": "boolean",
      "default": true
    },
    {
      "key": "visualTest",
      "label": "Visual test before deploy (opens the org in the browser with your LOCAL UI files + live org data)",
      "kind": "boolean",
      "default": false
    }
  ],
  "steps": [
    {
      "use": "snapshot",
      "title": "Snapshot baseline"
    },
    "plan",
    {
      "use": "implement-tdd.approve-plan",
      "as": "approve-plan"
    },
    {
      "use": "implement-tdd.work-check",
      "as": "work-check"
    },
    {
      "use": "retrieve-fresh",
      "title": "Retrieve fresh copies of files to be modified"
    },
    {
      "use": "retrieve-delta",
      "title": "Compare retrieved files against plan-time versions"
    },
    "rebaseline",
    {
      "use": "implement-tdd.implement",
      "as": "implement"
    },
    {
      "use": "changes",
      "title": "Collect changed files"
    },
    "verify-standards",
    {
      "use": "implement-tdd.review",
      "as": "review"
    },
    {
      "use": "implement-tdd.traceability",
      "as": "traceability"
    },
    {
      "use": "implement-tdd.approve-changes",
      "as": "approve-changes"
    },
    {
      "use": "bug-fix.validate",
      "as": "validate"
    },
    "validate-tests",
    "visual-preview",
    {
      "use": "implement-tdd.approve-deploy",
      "as": "approve-deploy"
    },
    {
      "use": "deploy",
      "title": "Deploy changed files"
    }
  ]
}
