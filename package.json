{
  "name": "dhruva",
  "version": "0.1.0",
  "description": "Dhruva - deterministic Salesforce delivery harness. Gated, auditable delivery workflows driven by swappable coding agents, on your machine with your logins.",
  "private": true,
  "bin": {
    "dhruva": "bin/dhruva.js"
  },
  "main": "electron/main.js",
  "build": {
    "appId": "com.prutech.dhruva",
    "productName": "Dhruva",
    "icon": "electron/icon.png",
    "directories": {
      "output": "dist-app"
    },
    "files": [
      "electron/**"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "app-bundle/.next/standalone",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".next/standalone/node_modules",
        "to": "app-bundle/.next/standalone/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".next/static",
        "to": "app-bundle/.next/standalone/.next/static"
      },
      {
        "from": "public",
        "to": "app-bundle/.next/standalone/public"
      },
      {
        "from": "standards",
        "to": "app-bundle/standards"
      },
      {
        "from": "workflows",
        "to": "app-bundle/workflows"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "shortcutName": "Dhruva"
    }
  },
  "files": [
    "bin",
    "src",
    "standards",
    "workflows",
    "public",
    "next.config.ts",
    "tsconfig.json",
    "postcss.config.mjs",
    "eslint.config.mjs",
    "README.md",
    "AGENTS.md"
  ],
  "scripts": {
    "dev": "next dev -p 3005",
    "build": "next build",
    "start": "next start -p 3005",
    "lint": "eslint src",
    "app": "electron .",
    "app:dist": "next build && electron-builder --win"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "mammoth": "^1.12.1",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "^16.0.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
